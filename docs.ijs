)

rmLatexGraphics=:3 : 0

NB.*rmLatexGraphics v-- remove/blank out LaTeX graphics.
NB.
NB. This verb  removes LaTeX comments  and  graphics environments
NB. from *.tex. This is done to produce lightweight EPUB and MOBI
NB. eBook  versions that perform well on  Kindles, iPhones, iPads
NB. and so forth.
NB.
NB. monad:  cl =. rmLatexGraphics clTex
NB.
NB.   tex=. read 'c:/pd/blog/wp2latex/cowboysandaliensando1698.tex'
NB.   rmLatexGraphics tex

rp=. <' '
tex=. <;.2 tlf y -. CR
tex=. ;('%' ~: {.@allwhitetrim&> tex) # tex
'ix cs'=. ('\begin{floatingfigure}';'\end{floatingfigure}') cutnestidx tex
tex=. ;rp ix} cs
'ix cs'=. ('\begin{SCfigure}';'\end{SCfigure}') cutnestidx tex
tex=. ;rp ix} cs
'ix cs'=. ('\begin{figure}';'\end{figure}') cutnestidx tex
if.  envtex=. ;ix{cs
     b0=. -.1 e. '\begin{minipage}' E. envtex
     b1=. 1 e. '\includegraphics' E. envtex
     b1 *. b0 do. tex=. ;rp ix} cs
end.
NB. clear any remaining caption setup pandoc passes them to .markdown
'ix cs'=. ('\captionsetup';'}';0) cutpxtidx tex
tex=. ;rp ix} cs
)

rntodo=:3 : 0

NB.*rntodo v-- renumber items in TODO style section.
NB.
NB. monad:  rntodo clTodoText
NB. 
NB.   file=. 'c:/mp/jupyter/smugpyter/todo.md'
NB.   todo=. read file
NB.   (toHOST rntodo todo) write file
NB.
NB. dyad: (clBegin ; clEnd) rntodo clTagText
NB.
NB.   NB. renumbers todo list style items in tagged list
NB.
NB.   tags=. '`[begin-list]`' ; '`[end-list]`'
NB.   file=. 'c:/temp/README.md'
NB.   readme=. read file
NB.   tags rntodo readme

('`[begin-todo]`';'`[end-todo]`') rntodo y
:
NB. preserve any preamble and suffix
'bdo edo'=. x
if. -.(+./bdo E. t) *. +./edo E. t=. ,y do. y return. end.
pam=. bdo beforestr t [ sfx=. edo afterstr t

NB. extract TAB free item text
t=. edo beforestr bdo afterstr t
t=. ' ' (I. TAB=y)} t
t=. ];._2 tlf t -. CR
t=. (*./"1 ' ' = t) <;.1 t

NB. all blanks
b=. 0 = #&> (,&.> t) -.&.> ' '
if. *./b do. y return. end.

NB. strip redundant blank lines from nonblanks
q=. I. -.b
t=. (rebrow&.> q{t) q} t
t=. ctl&.> t

NB. collect item numbers and following text
q=. I. -.b [ c=. '. '
r=. c&beforestr&.> q{t [ s=. c&afterstr&.> q{t

NB. renumber items
r=. (":&.> <"0 >: i. #r) ,&.> <c
t=. (r ,&.> s) q} t

NB. insert one blank line between items and return text
t=. }: , t ,. <2#LF
;(<pam),(<bdo),t,(<edo),<sfx
)

savethmtxt=:3 : 0

NB.*savethmtxt v-- save thm candidate sheets as text table.
NB.
NB. monad:  ilRCcnt =. savethmtxt uuIgnore

'~LEAN folder not configured' assert iscf '~LEAN'

NB. read sheet saved as CSV UTF8 !(*)=. jpath
csvpath=. '~LEAN/sheets/'
csv=. ujread csvpath,'theorem_candidates.csv'
'theorem_candidates_csv not saved' assert >0{csvpath putbyte 'theorem_candidates.csv'
ptxt=. parseutf8csv csv

NB. table checks
hdr=. allwhitetrim@,&.> 0{ptxt
'missing theorem table column(s)' assert (;:'GUID_Key Era') e. hdr

NB. eras
msg=. 'invalid Era(s)'
era=. }. ptxt{"1~hdr i.<'Era'
msg assert (allwhitetrim&.> ; <"1&.> era) e. 0 {"1 MATHERAS

NB. guids
msg=. 'invalid GUID_Key(s)'
gks=. allwhitetrim@,&.> }. ptxt {"1~ hdr i. <'GUID_Key'
msg assert ~:gks
msg assert '`<__>`' -: , ~. ;"1 (3&{. ;  _3&{.)&> gks
msg assert gks *./@e.&> <'`<__>`' , '0123456789abcdefghijklmnopqrstuvwxyz'

NB. bibtex citations
bib=. ujread '~LEAN/leanelements/gsbtex1/leanelements.bib'
cks=. bibkeys bib
cites=. BIBTEXMARKS betweenstrs csv
'invalid bibtex ref(s)' assert cites e. }. cks {"1 ~ (0{cks) i. <'BibTex_Key'

NB. portable box chars and write to file
winlcchars 0 [ txt=. ,(": ptxt) ,"1 CRLF [ portchars 0
(toHOST txt) write showpass jpath '~LEAN/sheets/theorem_candidates.txt'
(toHOST txt) write showpass jpath '~LEAN/leanelements/refmats/theorem_candidates.txt'
(toHOST bibfkeys 0) write showpass jpath '~LEAN/leanelements/refmats/citations.txt' 
csv write showpass jpath '~LEAN/leanelements/refmats/theorem_candidates.csv'

NB. rows and columns in parsed csv
showpass eracounts ptxt
$ptxt
)

