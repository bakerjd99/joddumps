t=. t,'\multicolumn{1}{l|}{',(":sgym),  '}  &',LF
t=. t,'\multicolumn{1}{l|}{',(":sbx5),  '}  &',LF
t=. t,'\multicolumn{1}{l|}{',(":swalk), '}  &',LF
