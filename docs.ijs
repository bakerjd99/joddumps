versionymw=:3 : 0

NB.*versionymw v-- year month week tally from start date.
NB.
NB. monad: il =. versionymw ilYYYYMMDD
NB. 
NB.   versionymw 2001 9 11

td=. today ''
'current date precedes start date' assert </ todayno y ,: td
tm=. +/y monthsbetween td
<.((0{td) - 0{y),tm,y weekcount td
)

weekcount=:[: +/ ([: weeknumber [) weeksbetween [: weeknumber ]

winpathsep=:'\'&(('/' I.@:= ])} )

writeneochaps=:3 : 0

NB.*writeneochaps v-- split neo md and write chapter md, docx and pandoc shell script.
NB.
NB. monad:  blcl =. writeneochaps uuIgnore

NB. erase any old chapter files !(*)=. dir
ferase 1 dir '~ANEO/chap*.md'
ferase 1 dir '~ANEO/chap*.docx'

NB. write md chapter files
aneop=. jpath '~ANEO/'
cutmd=. cutneomd 0
chpfx=. 'chap'&, &.> 'r<0>4.0' (8!:0) >:i.#cutmd
chmd=.   ,&'.md' &.> chpfx
chdocx=. ,&'.docx' &.> chpfx
cutmd write&.> chfiles=. (<aneop) ,&.> chmd
'missing chapter file(s)' assert fexist chfiles

NB. create shell md->docx script !(*)=. IFWIN toHOST
hd=.   ;IFWIN{'cd ~/00awips/anostomyte/zneo';'cd C:\00awips\anostomyte\zneo'
shex=. ;IFWIN{'.sh';'.bat'
shcm=. ;IFWIN{'# ';'rem '
hd=. (shcm,timestamp ''),LF,hd
sh=. ctl ;"1 (<'pandoc ') ,"1 chmd ,. (<' -o ') ,. chdocx
(toHOST hd,(2#LF),sh) write shcmd=. aneop,'chapdocx',shex
'missing docx script' assert fexist shcmd
chmd
)

