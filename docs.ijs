ptableFrwpxml=:3 : 0

NB.*ptableFrwpxml v-- type status table from wordpress xml.
NB.
NB. monad:  btcl =. ptableFrwpxml clXml
NB.
NB.   wpxml=. read 'c:/pd/blog/wordpress/analyzethedatanotthedrivel.wordpress.xml'
