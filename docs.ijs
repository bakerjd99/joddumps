y=. winpathsep y
(inext,' extension required') assert (inext-.'.') -: justext y
file=. justfile y
drv=. ]`(]@,&':')@.(0 < #) justdrv y
dir=.  tlslash drv,justpath y
NB. output written to same directory as source
