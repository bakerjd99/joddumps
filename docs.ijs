sdf=. './'&afterstr&.> files #~ {.@:((;{:pxd)&E.)&> files

NB. format paths for copying !(*)=. IFWIN
~. pxf,allwhitetrim&.> <"1 (IFWIN|.'\/') charsub >sdf
)

